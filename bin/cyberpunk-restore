#!/data/data/com.termux/files/usr/bin/bash
set -u
BACKUP_ROOT="$HOME/.local/share/termux-cyberpunk/backups"
MARK_START="# >>> termux-cyberpunk >>>"
MARK_END="# <<< termux-cyberpunk <<<"
[ -d "$BACKUP_ROOT" ] || { echo "No backup directory found: $BACKUP_ROOT"; exit 1; }
LATEST="$BACKUP_ROOT/original"
if [ ! -d "$LATEST" ]; then LATEST="$(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d | sort | tail -n 1)"; fi
[ -n "$LATEST" ] && [ -d "$LATEST" ] || { echo "No backups found."; exit 1; }
echo "Restoring from: $LATEST"
if [ -f "$HOME/.bashrc" ]; then
  tmp="$(mktemp "$HOME/.bashrc.cyberpunk.XXXXXX")" || exit 1
  awk -v start="$MARK_START" -v end="$MARK_END" '$0==start {skip=1; next} $0==end {skip=0; next} !skip {print}' "$HOME/.bashrc" > "$tmp"
  if ! cmp -s "$HOME/.bashrc" "$tmp"; then cp -p "$HOME/.bashrc" "$LATEST/bashrc-before-restore" 2>/dev/null || true; cat "$tmp" > "$HOME/.bashrc"; echo "Removed managed block; unrelated .bashrc lines preserved."; fi
  rm -f "$tmp"
fi
restore_config() {
  local rel="$1" backup_name="$2" dest="$3" installed="$4"
  if [ -f "$LATEST/$backup_name" ]; then
    if [ -f "$dest" ] && [ -f "$LATEST/installed/$installed" ] && ! cmp -s "$dest" "$LATEST/installed/$installed"; then echo "Preserving user-modified $dest."; return; fi
    mkdir -p "$(dirname "$dest")"; cp -p "$LATEST/$backup_name" "$dest"; echo "Restored $dest"
  elif [ -f "$LATEST/created-by-installer.txt" ] && grep -Fxq "$rel" "$LATEST/created-by-installer.txt"; then
    if [ -f "$dest" ] && [ -f "$LATEST/installed/$installed" ] && ! cmp -s "$dest" "$LATEST/installed/$installed"; then echo "Preserving user-modified $dest."; return; fi
    rm -f "$dest"; echo "Removed installer-created $dest"
  else echo "No original backup for $dest; leaving it in place."; fi
}
restore_config ".termux/colors.properties" "colors.properties" "$HOME/.termux/colors.properties" "colors.properties"
restore_config ".termux/termux.properties" "termux.properties" "$HOME/.termux/termux.properties" "termux.properties"
rm -f "$HOME/.local/bin/cyberpunk" "$HOME/.local/bin/cyberpunk-dashboard" "$HOME/.local/bin/cyberpunk-voice" "$HOME/.local/bin/cyberpunk-restore" "$HOME/.local/bin/cyberpunk-manager" "$HOME/.local/bin/cyberpunk-banner.sh" "$HOME/.local/bin/cyberpunk-dashboard.sh" "$HOME/.local/bin/cyberpunk-voice.sh"
echo "Restore complete. Restart Termux. Original backup history and user settings were retained."
