#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
BACKUPS="$HOME/.local/share/termux-cyberpunk/manual-backups"
mkdir -p "$BACKUPS"
create_backup() {
 name="$(date '+%Y%m%d-%H%M%S')"; dest="$BACKUPS/$name"; mkdir -p "$dest"
 [ ! -f "$HOME/.config/termux-cyberpunk/config" ] || cp -p "$HOME/.config/termux-cyberpunk/config" "$dest/config"
 [ ! -f "$HOME/.termux/colors.properties" ] || cp -p "$HOME/.termux/colors.properties" "$dest/colors.properties"
 [ ! -f "$HOME/.termux/termux.properties" ] || cp -p "$HOME/.termux/termux.properties" "$dest/termux.properties"
 [ ! -f "$HOME/.termux/font.ttf" ] || cp -p "$HOME/.termux/font.ttf" "$dest/font.ttf"
 printf 'Created backup: %s\n' "$dest"
}
ACTION="$1"; [ -n "$ACTION" ] || ACTION=create
case "$ACTION" in
 create|backup) create_backup ;;
 list) echo "Available Cyberpunk backups:"; found=0; for d in "$BACKUPS"/*; do [ -d "$d" ] || continue; found=1; printf '  %s\n' "$(basename "$d")"; done; [ "$found" = 1 ] || echo "  (none)" ;;
 restore) wanted="$2"; [ -n "$wanted" ] || wanted=latest; if [ "$wanted" = latest ]; then wanted="$(find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | tail -n 1)"; fi; [[ "$wanted" =~ ^[0-9]{8}-[0-9]{6}$ ]] || { echo "Usage: cyberpunk-backup restore [backup-name|latest]" >&2; exit 2; }; source_dir="$BACKUPS/$wanted"; [ -d "$source_dir" ] || { echo "Backup not found: $wanted" >&2; exit 1; }; echo "Restore only affects Cyberpunk config and Termux appearance files."; read -r -p "Restore '$wanted'? [y/N] " confirm; case "$confirm" in y|Y|yes|YES) ;; *) echo "Cancelled."; exit 0 ;; esac; create_backup; mkdir -p "$HOME/.config/termux-cyberpunk" "$HOME/.termux"; [ ! -f "$source_dir/config" ] || cp -p "$source_dir/config" "$HOME/.config/termux-cyberpunk/config"; [ ! -f "$source_dir/colors.properties" ] || cp -p "$source_dir/colors.properties" "$HOME/.termux/colors.properties"; [ ! -f "$source_dir/termux.properties" ] || cp -p "$source_dir/termux.properties" "$HOME/.termux/termux.properties"; [ ! -f "$source_dir/font.ttf" ] || cp -p "$source_dir/font.ttf" "$HOME/.termux/font.ttf"; command -v termux-reload-settings >/dev/null 2>&1 && termux-reload-settings || true; echo "Restore complete." ;;
 -h|--help|help) echo "Usage: cyberpunk-backup {create|list|restore [backup-name|latest]}" ;;
 *) echo "Usage: cyberpunk-backup {create|list|restore [backup-name|latest]}" >&2; exit 2 ;;
esac
