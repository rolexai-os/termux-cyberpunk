#!/data/data/com.termux/files/usr/bin/bash
set -u
CONFIG="$HOME/.config/termux-cyberpunk/config"
[ -f "$CONFIG" ] && . "$CONFIG"
"$(dirname "$0")/cyberpunk-banner.sh"
"$(dirname "$0")/cyberpunk-dashboard.sh"
if [ "${CYBERPUNK_AUTO_VOICE:-0}" = "1" ]; then
  "$(dirname "$0")/cyberpunk-voice.sh" >/dev/null 2>&1 || true
fi
