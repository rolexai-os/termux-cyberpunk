#!/data/data/com.termux/files/usr/bin/bash
set -u
CONFIG="$HOME/.config/termux-cyberpunk/config"
mkdir -p "$(dirname "$CONFIG")"
[ -f "$CONFIG" ] || cat > "$CONFIG" <<'CFG'
CYBERPUNK_ANIMATION=1
CYBERPUNK_AUTO_VOICE=0
CYBERPUNK_VOICE_GREETING="Cyberpunk terminal online. Systems ready."
CFG
load_config() { . "$CONFIG"; }
set_config() {
  local key="$1" value="$2" tmp
  tmp="$(mktemp "${CONFIG}.XXXXXX")" || return 1
  if grep -qE "^[[:space:]]*${key}=" "$CONFIG"; then
    awk -v key="$key" -v value="$value" 'index($0,key "=")==1 {print key "=" value; next} {print}' "$CONFIG" > "$tmp"
  else
    cat "$CONFIG" > "$tmp"
    printf '\n%s=%s\n' "$key" "$value" >> "$tmp"
  fi
  cat "$tmp" > "$CONFIG"
  rm -f "$tmp"
}
while true; do
  load_config
  printf '\n\033[1;36m=== CYBERPUNK THEME MANAGER ===\033[0m\n'
  printf '1) Show banner + dashboard\n2) Refresh dashboard\n3) Test voice greeting\n4) Toggle startup animation (now: %s)\n5) Toggle automatic voice (now: %s)\n6) Change voice greeting\n7) Choose terminal color theme\n8) Banner / FIGlet styles\n9) Font collection manager\n10) Update from GitHub\n11) Restore/uninstall\n0) Exit\n' "${CYBERPUNK_ANIMATION:-1}" "${CYBERPUNK_AUTO_VOICE:-0}"
  read -r -p 'Select: ' choice || exit 0
  case "$choice" in
    1) "$HOME/.local/bin/cyberpunk" ;;
    2) "$HOME/.local/bin/cyberpunk-dashboard" ;;
    3) "$HOME/.local/bin/cyberpunk-voice" ;;
    4) if [ "${CYBERPUNK_ANIMATION:-1}" = 1 ]; then set_config CYBERPUNK_ANIMATION 0; else set_config CYBERPUNK_ANIMATION 1; fi; echo "Saved." ;;
    5) if [ "${CYBERPUNK_AUTO_VOICE:-0}" = 1 ]; then set_config CYBERPUNK_AUTO_VOICE 0; else set_config CYBERPUNK_AUTO_VOICE 1; fi; echo "Saved." ;;
    6)
      read -r -p 'Enter greeting (empty cancels): ' greeting || exit 0
      if [ -n "$greeting" ]; then
        escaped="$(printf '%s' "$greeting" | sed 's/\\/\\\\/g; s/"/\\"/g')"
        set_config CYBERPUNK_VOICE_GREETING "\"$escaped\""
        echo "Greeting saved."
      fi ;;
    7)
      "$HOME/.local/bin/cyberpunk-style" --list
      read -r -p 'Theme name (empty cancels): ' theme || exit 0
      [ -z "$theme" ] || "$HOME/.local/bin/cyberpunk-style" "$theme" ;;
    8)
      "$HOME/.local/bin/cyberpunk-art" --list
      read -r -p 'Banner style (cyberpunk/matrix/compact/figlet/toilet/rainbow): ' art_style || exit 0
      read -r -p 'Text to render (empty uses CYBERPUNK): ' art_text || exit 0
      [ -n "$art_text" ] || art_text=CYBERPUNK
      "$HOME/.local/bin/cyberpunk-art" "$art_style" "$art_text" ;;
    9) "$HOME/.local/bin/cyberpunk-fonts" list ;;
    10) read -r -p 'Update repository and reinstall? [y/N] ' confirm || exit 0; case "$confirm" in y|Y|yes|YES) "$HOME/.local/bin/cyberpunk-update" ;; *) echo "Cancelled." ;; esac ;;
    11) read -r -p 'Restore/uninstall theme? [y/N] ' confirm || exit 0; case "$confirm" in y|Y|yes|YES) "$HOME/.local/bin/cyberpunk-restore"; exit $? ;; *) echo "Cancelled." ;; esac ;;
    0|q|Q) exit 0 ;;
    *) echo "Choose a listed option." ;;
  esac
done
