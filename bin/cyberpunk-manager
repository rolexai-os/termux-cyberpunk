#!/data/data/com.termux/files/usr/bin/bash
set -u
CONFIG="$HOME/.config/termux-cyberpunk/config"
mkdir -p "$(dirname "$CONFIG")"
[ -f "$CONFIG" ] || cat > "$CONFIG" <<'CFG'
CYBERPUNK_ANIMATION=1
CYBERPUNK_LOADING=1
CYBERPUNK_AUTO_START=1
CYBERPUNK_AUTO_VOICE=0
CYBERPUNK_VOICE_STYLE=cinematic
CYBERPUNK_VOICE_PITCH=0.82
CYBERPUNK_VOICE_RATE=0.90
CYBERPUNK_VOICE_GREETING="Good evening. All systems are online. How may I assist you?"
CYBERPUNK_STARTUP_COMMAND_B64=''
CFG
load_config() { . "$CONFIG"; }
set_config() {
  local key="$1" value="$2" tmp
  tmp="$(mktemp "${CONFIG}.XXXXXX")" || return 1
  if grep -qE "^[[:space:]]*${key}=" "$CONFIG"; then
    awk -v key="$key" -v value="$value" 'index($0,key "=")==1 {print key "=" value; next} {print}' "$CONFIG" > "$tmp"
  else
    cat "$CONFIG" > "$tmp"
    printf '\n%s=%s\n' "$key" "$value" >> "$tmp"
  fi
  cat "$tmp" > "$CONFIG"
  rm -f "$tmp"
}
toggle() {
  local key="$1" current="$2"
  if [ "$current" = 1 ]; then set_config "$key" 0; echo "$key disabled."
  else set_config "$key" 1; echo "$key enabled."; fi
}
while true; do
  load_config
  printf '\n\033[1;36m╔══════════════════════════════════════╗\033[0m\n'
  printf '\033[1;36m║       CYBERPUNK CONTROL CENTER       ║\033[0m\n'
  printf '\033[1;36m╚══════════════════════════════════════╝\033[0m\n'
  printf '1) Launch terminal dashboard\n2) Refresh system dashboard\n3) Test assistant voice\n4) Voice profile: %s\n5) Auto-start banner: %s\n6) Digital loading animation: %s\n7) Banner animation: %s\n8) Automatic voice: %s\n9) Change greeting\n10) Choose color theme\n11) Banner / FIGlet styles\n12) Font manager\n13) Clean settings / fresh install\n14) Update from GitHub\n15) Restore / uninstall\n16) Set startup command/app\n17) Voice setup tips\n18) Plugin manager\n19) Backup / restore settings\n20) Live system monitor\n21) Voice command shortcuts\n0) Exit\n' "${CYBERPUNK_VOICE_STYLE:-cinematic}" "${CYBERPUNK_AUTO_START:-1}" "${CYBERPUNK_LOADING:-1}" "${CYBERPUNK_ANIMATION:-1}" "${CYBERPUNK_AUTO_VOICE:-0}"
  read -r -p 'Select: ' choice || exit 0
  case "$choice" in
    1) "$HOME/.local/bin/cyberpunk" ;;
    2) "$HOME/.local/bin/cyberpunk-dashboard" ;;
    3) "$HOME/.local/bin/cyberpunk-voice" ;;
    4)
      echo "1) Cinematic assistant (lower pitch, slower)  2) Balanced  3) Crisp"
      read -r -p 'Choose profile: ' profile || exit 0
      case "$profile" in
        1) set_config CYBERPUNK_VOICE_STYLE cinematic; set_config CYBERPUNK_VOICE_PITCH 0.82; set_config CYBERPUNK_VOICE_RATE 0.90 ;;
        2) set_config CYBERPUNK_VOICE_STYLE balanced; set_config CYBERPUNK_VOICE_PITCH 0.96; set_config CYBERPUNK_VOICE_RATE 1.00 ;;
        3) set_config CYBERPUNK_VOICE_STYLE crisp; set_config CYBERPUNK_VOICE_PITCH 0.92; set_config CYBERPUNK_VOICE_RATE 1.08 ;;
        *) echo "Cancelled." ;;
      esac ;;
    5) toggle CYBERPUNK_AUTO_START "${CYBERPUNK_AUTO_START:-1}" ;;
    6) toggle CYBERPUNK_LOADING "${CYBERPUNK_LOADING:-1}" ;;
    7) toggle CYBERPUNK_ANIMATION "${CYBERPUNK_ANIMATION:-1}" ;;
    8) toggle CYBERPUNK_AUTO_VOICE "${CYBERPUNK_AUTO_VOICE:-0}" ;;
    9)
      read -r -p 'New greeting (empty cancels): ' greeting || exit 0
      if [ -n "$greeting" ]; then
        escaped="$(printf '%s' "$greeting" | sed 's/\\/\\\\/g; s/"/\\"/g')"
        set_config CYBERPUNK_VOICE_GREETING "\"$escaped\""
        echo "Greeting saved."
      fi ;;
    10)
      "$HOME/.local/bin/cyberpunk-style" --list
      read -r -p 'Theme name (empty cancels): ' theme || exit 0
      [ -z "$theme" ] || "$HOME/.local/bin/cyberpunk-style" "$theme" ;;
    11)
      "$HOME/.local/bin/cyberpunk-art" --list
      read -r -p 'Banner style: ' art_style || exit 0
      read -r -p 'Text (empty uses CYBERPUNK): ' art_text || exit 0
      [ -n "$art_text" ] || art_text=CYBERPUNK
      "$HOME/.local/bin/cyberpunk-art" "$art_style" "$art_text" ;;
    12) "$HOME/.local/bin/cyberpunk-fonts" list ;;
    13)
      echo "1) Reset settings  2) Refresh cached themes  3) Fresh reinstall"
      read -r -p 'Choose action: ' clean_action || exit 0
      case "$clean_action" in
        1) "$HOME/.local/bin/cyberpunk-clean" settings ;;
        2) "$HOME/.local/bin/cyberpunk-clean" themes ;;
        3) "$HOME/.local/bin/cyberpunk-clean" fresh ;;
        *) echo "Cancelled." ;;
      esac ;;
    14) read -r -p 'Update from GitHub and reinstall? [y/N] ' confirm || exit 0; case "$confirm" in y|Y|yes|YES) "$HOME/.local/bin/cyberpunk-update" ;; *) echo "Cancelled." ;; esac ;;
    15) read -r -p 'Restore/uninstall? [y/N] ' confirm || exit 0; case "$confirm" in y|Y|yes|YES) "$HOME/.local/bin/cyberpunk-restore"; exit $? ;; *) echo "Cancelled." ;; esac ;;
    16)
      echo "Enter a command or app to run after the banner/dashboard (example: neofetch, htop, python, or cd ~/project && python app.py)."
      echo "Leave empty to disable. Only enter commands you trust; this runs in your shell at startup."
      read -r -p 'Startup command: ' startup_command || exit 0
      if [ -z "$startup_command" ]; then
        set_config CYBERPUNK_STARTUP_COMMAND_B64 "''"
        echo "Startup command disabled."
      else
        encoded="$(printf '%s' "$startup_command" | base64 | tr -d '\n')"
        set_config CYBERPUNK_STARTUP_COMMAND_B64 "$encoded"
        echo "Startup command saved. It will run after the dashboard when Cyberpunk starts."
      fi ;;
    17)
      echo "For a male assistant-style voice, open Android Settings > Text-to-speech output."
      echo "Choose a TTS engine and select an available male voice/English voice variant."
      echo "Then run: cyberpunk-voice"
      echo "The cinematic profile requests lower pitch/slower speech; exact timbre depends on your TTS engine."
      echo "It does not clone Tony Stark or Robert Downey Jr.'s voice." ;;
    18) "$HOME/.local/bin/cyberpunk-plugins" list
      echo "1) Create starter plugin  2) Install local plugin  3) Run plugin  4) Remove plugin"
      read -r -p 'Plugin action: ' plugin_action || exit 0
      case "$plugin_action" in
        1) read -r -p 'New plugin name: ' plugin_name || exit 0; "$HOME/.local/bin/cyberpunk-plugins" create "$plugin_name" ;;
        2) read -r -p 'Path to local .sh plugin: ' plugin_path || exit 0; "$HOME/.local/bin/cyberpunk-plugins" install "$plugin_path" ;;
        3) read -r -p 'Plugin name: ' plugin_name || exit 0; "$HOME/.local/bin/cyberpunk-plugins" run "$plugin_name" ;;
        4) read -r -p 'Plugin name: ' plugin_name || exit 0; "$HOME/.local/bin/cyberpunk-plugins" remove "$plugin_name" ;;
        *) echo "Cancelled." ;;
      esac ;;
    19) echo "1) Create backup  2) List backups  3) Restore latest / named backup"
      read -r -p 'Backup action: ' backup_action || exit 0
      case "$backup_action" in
        1) "$HOME/.local/bin/cyberpunk-backup" create ;;
        2) "$HOME/.local/bin/cyberpunk-backup" list ;;
        3) read -r -p 'Backup name (latest for newest): ' backup_name || exit 0; "$HOME/.local/bin/cyberpunk-backup" restore "$backup_name" ;;
        *) echo "Cancelled." ;;
      esac ;;
    20) "$HOME/.local/bin/cyberpunk-monitor" --watch 3 ;;
    21) "$HOME/.local/bin/cyberpunk-listen" ;;
    0|q|Q) exit 0 ;;
    *) echo "Choose a listed option." ;;
  esac
done
